{
  "expo": {
    "name": "u-manifest",
    "slug": "u-manifest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "umanifest",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Urbanist-Thin.ttf",
            "./assets/fonts/Urbanist-ThinItalic.ttf",
            "./assets/fonts/Urbanist-ExtraLight.ttf",
            "./assets/fonts/Urbanist-ExtraLightItalic.ttf",
            "./assets/fonts/Urbanist-Light.ttf",
            "./assets/fonts/Urbanist-LightItalic.ttf",
            "./assets/fonts/Urbanist-Regular.ttf",
            "./assets/fonts/Urbanist-Italic.ttf",
            "./assets/fonts/Urbanist-Medium.ttf",
            "./assets/fonts/Urbanist-MediumItalic.ttf",
            "./assets/fonts/Urbanist-SemiBold.ttf",
            "./assets/fonts/Urbanist-SemiBoldItalic.ttf",
            "./assets/fonts/Urbanist-Bold.ttf",
            "./assets/fonts/Urbanist-BoldItalic.ttf",
            "./assets/fonts/Urbanist-ExtraBold.ttf",
            "./assets/fonts/Urbanist-ExtraBoldItalic.ttf",
            "./assets/fonts/Urbanist-Black.ttf",
            "./assets/fonts/Urbanist-BlackItalic.ttf"
          ]
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}